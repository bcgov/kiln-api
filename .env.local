# kiln-api Environment Variables Template
# Copy this file to .env and update with your actual values

# Application Configuration
APP_ID=kiln-api
PORT=3001
LOG_LEVEL=debug
REQUEST_LIMIT=100kb
SESSION_SECRET=mySecret

INTERNAL_SERVICE_MODE=true

STANDALONE_MODE=false
DEV_COOKIE_AUTH=true
DEV_COOKIE_NAME=username

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8080

SWAGGER_API_SPEC=/api/spec

COMM_API_TIMEOUT=30000

COMM_API_SAVEDATA_ICM_ENDPOINT_URL=http://localhost:3030/saveICMData
COMM_API_LOADDATA_ICM_ENDPOINT_URL=http://localhost:3030/loadICMData
COMM_API_UNLOCK_ICM_ENDPOINT_URL=http://localhost:3030/clearICMLockedFlag
COMM_API_LOADSAVEDJSON_ENDPOINT_URL=http://localhost:3030/loadSavedJson
COMM_API_GENERATE_ENDPOINT_URL=http://localhost:3030/generate
COMM_API_GENERATE_NEWTEMPLATE_ENDPOINT_URL=http://localhost:3030/generateNewTemplate
COMM_API_PDFTEMPLATE_ENDPOINT_URL=http://localhost:3030/pdfRender
COMM_API_GENERATE_PDF_FROM_JSON_ENDPOINT_URL=http://localhost:3030/generatePDFFromJson
COMM_API_GENERATE_PORTAL_FORM_ENDPOINT_URL=http://localhost:3030/generatePortalForm
COMM_API_LOAD_PORTAL_FORM_ENDPOINT_URL=http://localhost:3030/loadPortalForm
COMM_API_SUBMIT_TO_ACTION_ENDPOINT_URL=http://localhost:3030/submitForPortalAction
COMM_API_LOADDATA_ICM_AS_PDF_ENDPOINT_URL=http://host.docker.internal:3030/loadICMDataAsPDF

# in dev, can use same password/port as Communication-Layer
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=password
