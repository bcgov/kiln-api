APP_ID=kiln-api
PORT=3001
LOG_LEVEL=debug
REQUEST_LIMIT=100kb
SESSION_SECRET=mySecret

#Authentication Configuration
# Enable/disable authentication globally
AUTH_ENABLED=true

# Standalone mode bypasses all auth (for development)
STANDALONE_MODE=false

# Portal integration mode (different auth flow)
IS_PORTAL_INTEGRATED=false

# Keycloak OAuth2/OIDC Configuration
KEYCLOAK_ENABLED=true
KEYCLOAK_REALM=standard
KEYCLOAK_AUTH_SERVER_URL=https://dev.loginproxy.gov.bc.ca/auth
KEYCLOAK_CLIENT_ID=forms-flow-web

# Cookie-based fallback authentication
COOKIE_AUTH_ENABLED=true
COOKIE_AUTH_NAME=username

#CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

#Swagger
SWAGGER_API_SPEC=/api/spec

#ICM Integration
COMM_API_TIMEOUT=30000
COMM_API_SAVEDATA_ICM_ENDPOINT_URL=http://localhost:3030/saveICMData
COMM_API_LOADDATA_ICM_ENDPOINT_URL=http://localhost:3030/loadICMData
COMM_API_UNLOCK_ICM_ENDPOINT_URL=http://localhost:3030/clearICMLockedFlag
COMM_API_LOADSAVEDJSON_ENDPOINT_URL=http://localhost:3030/loadSavedJson
COMM_API_GENERATE_ENDPOINT_URL=http://localhost:3030/generate
COMM_API_PDFTEMPLATE_ENDPOINT_URL=
COMM_API_LOAD_PORTAL_FORM_ENDPOINT_URL=
COMM_API_SUBMIT_TO_ACTION_ENDPOINT_URL=
